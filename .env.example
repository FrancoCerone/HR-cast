# Token API HypeRate condiviso (obbligatorio per sottoscrizioni Watch)
HYPERATE_TOKEN=

# Chiave per trigger esterni start/stop allenamento (header X-API-Key o ?key=)
# CONTROL_API_KEY=cambia-questa-chiave

# PORT=3033
# ROOM=spinning
# HTTPS=false
# URL pubblico fisso. Se vuoto, il QR legge il tunnel ngrok da http://127.0.0.1:4040
# PUBLIC_URL=https://tuo-nome.ngrok-free.dev
# HYPERATE_WS_URL=wss://app.hyperate.io/socket/websocket
# HYPERATE_ORIGIN=https://app.hyperate.io
